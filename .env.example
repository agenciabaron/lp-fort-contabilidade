# Copy to .env.local for local testing. In production, set these in Vercel → Settings → Environment Variables.

# Admin panel (/admin/). Generate the hash and the secret with: npm run admin:senha
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Where contact messages are saved. Added automatically when you connect Upstash Redis
# in Vercel → Storage. Leave empty locally: messages go to .data/leads.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
